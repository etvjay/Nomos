{
  "schemaVersion": "0.1.0",
  "primitive": "ppa-receipt-adapter",
  "version": "v0.1",
  "mode": "EXACT",
  "sender": "0x2bd806c97f0e00af1a1fc3328fa763a9269723c8",
  "note": "Adapter-side adjudicator registry and origin binding. The sender is the sole caller in this corpus, so a self-registered adjudicator yields origin_status BOUND. Genuinely different callers are specified in tests/split/ and tests/../ppa-receipt-adapter tests.",
  "vectors": [
    {"id": "ppa-receipt-adapter/registry-001", "description": "owner registers an adjudicator with an authority fingerprint",
     "actions": [
      {"op": "initialize", "args": ["0x2bd806c97f0e00af1a1fc3328fa763a9269723c8", "0x0000000000000000000000000000000000000001"], "expect": "ok"},
      {"op": "register_adjudicator", "args": ["{\"source_contract\":\"0x2bd806c97f0e00af1a1fc3328fa763a9269723c8\",\"authority_fingerprint\":\"sha256:fp-001\",\"policy_version\":\"TECH-V1\",\"created_at\":\"2020-01-01T00:00:00+00:00\",\"expires_at\":\"2099-01-01T00:00:00+00:00\"}"], "expect": "ok"},
      {"op": "get_adjudicator", "args": ["0x2bd806c97f0e00af1a1fc3328fa763a9269723c8"], "expect": {"status": "ACTIVE"}}]},

    {"id": "ppa-receipt-adapter/bound-accepted-receipt-002", "description": "registered caller with matching fingerprint -> ACTIONABLE",
     "actions": [
      {"op": "initialize", "args": ["0x2bd806c97f0e00af1a1fc3328fa763a9269723c8", "0x0000000000000000000000000000000000000001"], "expect": "ok"},
      {"op": "register_adjudicator", "args": ["{\"source_contract\":\"0x2bd806c97f0e00af1a1fc3328fa763a9269723c8\",\"authority_fingerprint\":\"sha256:fp-001\",\"policy_version\":\"TECH-V1\",\"created_at\":\"2020-01-01T00:00:00+00:00\",\"expires_at\":\"2099-01-01T00:00:00+00:00\"}"], "expect": "ok"},
      {"op": "submit_decision_receipt", "args": ["{\"decision_id\":\"D1\",\"source_contract\":\"0x2bd806c97f0e00af1a1fc3328fa763a9269723c8\",\"authority_fingerprint\":\"sha256:fp-001\",\"question_hash\":\"sha256:q\",\"evidence_hash\":\"sha256:e\",\"decision_status\":\"ACCEPTED\",\"equivalence_mode\":\"comparative\",\"policy_version\":\"TECH-V1\",\"created_at\":\"2020-01-01T00:00:00+00:00\",\"expires_at\":\"2099-01-01T00:00:00+00:00\"}"], "expect": "ok"},
      {"op": "get_receipt", "args": ["D1"], "expect": {"actionability": "ACTIONABLE", "origin_status": "BOUND", "decision_status": "ACCEPTED"}}]},

    {"id": "ppa-receipt-adapter/unregistered-source-003", "description": "caller with no registry entry -> REJECTED_SOURCE_NOT_REGISTERED",
     "actions": [
      {"op": "initialize", "args": ["0x2bd806c97f0e00af1a1fc3328fa763a9269723c8", "0x0000000000000000000000000000000000000001"], "expect": "ok"},
      {"op": "submit_decision_receipt", "args": ["{\"decision_id\":\"D3\",\"source_contract\":\"0x2bd806c97f0e00af1a1fc3328fa763a9269723c8\",\"authority_fingerprint\":\"sha256:fp-001\",\"question_hash\":\"sha256:q\",\"evidence_hash\":\"sha256:e\",\"decision_status\":\"ACCEPTED\",\"equivalence_mode\":\"comparative\",\"policy_version\":\"TECH-V1\",\"created_at\":\"2020-01-01T00:00:00+00:00\",\"expires_at\":\"2099-01-01T00:00:00+00:00\"}"], "expect": "ok"},
      {"op": "get_receipt", "args": ["D3"], "expect": {"actionability": "NON_ACTIONABLE", "fail_reason": "REJECTED_SOURCE_NOT_REGISTERED", "origin_status": "UNREGISTERED"}}]},

    {"id": "ppa-receipt-adapter/fingerprint-mismatch-004", "description": "receipt fingerprint differing from the registry -> mismatch",
     "actions": [
      {"op": "initialize", "args": ["0x2bd806c97f0e00af1a1fc3328fa763a9269723c8", "0x0000000000000000000000000000000000000001"], "expect": "ok"},
      {"op": "register_adjudicator", "args": ["{\"source_contract\":\"0x2bd806c97f0e00af1a1fc3328fa763a9269723c8\",\"authority_fingerprint\":\"sha256:fp-001\",\"policy_version\":\"TECH-V1\",\"created_at\":\"2020-01-01T00:00:00+00:00\",\"expires_at\":\"2099-01-01T00:00:00+00:00\"}"], "expect": "ok"},
      {"op": "submit_decision_receipt", "args": ["{\"decision_id\":\"D4\",\"source_contract\":\"0x2bd806c97f0e00af1a1fc3328fa763a9269723c8\",\"authority_fingerprint\":\"sha256:fp-DIFFERENT\",\"question_hash\":\"sha256:q\",\"evidence_hash\":\"sha256:e\",\"decision_status\":\"ACCEPTED\",\"equivalence_mode\":\"comparative\",\"policy_version\":\"TECH-V1\",\"created_at\":\"2020-01-01T00:00:00+00:00\",\"expires_at\":\"2099-01-01T00:00:00+00:00\"}"], "expect": "ok"},
      {"op": "get_receipt", "args": ["D4"], "expect": {"actionability": "NON_ACTIONABLE", "fail_reason": "REJECTED_SOURCE_FINGERPRINT_MISMATCH"}}]},

    {"id": "ppa-receipt-adapter/revoked-source-005", "description": "revoked adjudicator -> non-actionable",
     "actions": [
      {"op": "initialize", "args": ["0x2bd806c97f0e00af1a1fc3328fa763a9269723c8", "0x0000000000000000000000000000000000000001"], "expect": "ok"},
      {"op": "register_adjudicator", "args": ["{\"source_contract\":\"0x2bd806c97f0e00af1a1fc3328fa763a9269723c8\",\"authority_fingerprint\":\"sha256:fp-001\",\"policy_version\":\"TECH-V1\",\"created_at\":\"2020-01-01T00:00:00+00:00\",\"expires_at\":\"2099-01-01T00:00:00+00:00\"}"], "expect": "ok"},
      {"op": "revoke_adjudicator", "args": ["0x2bd806c97f0e00af1a1fc3328fa763a9269723c8"], "expect": "ok"},
      {"op": "submit_decision_receipt", "args": ["{\"decision_id\":\"D5\",\"source_contract\":\"0x2bd806c97f0e00af1a1fc3328fa763a9269723c8\",\"authority_fingerprint\":\"sha256:fp-001\",\"question_hash\":\"sha256:q\",\"evidence_hash\":\"sha256:e\",\"decision_status\":\"ACCEPTED\",\"equivalence_mode\":\"comparative\",\"policy_version\":\"TECH-V1\",\"created_at\":\"2020-01-01T00:00:00+00:00\",\"expires_at\":\"2099-01-01T00:00:00+00:00\"}"], "expect": "ok"},
      {"op": "get_receipt", "args": ["D5"], "expect": {"actionability": "NON_ACTIONABLE", "fail_reason": "REJECTED_SOURCE_NOT_REGISTERED"}}]},

    {"id": "ppa-receipt-adapter/undetermined-006", "description": "UNDETERMINED never becomes actionable",
     "actions": [
      {"op": "initialize", "args": ["0x2bd806c97f0e00af1a1fc3328fa763a9269723c8", "0x0000000000000000000000000000000000000001"], "expect": "ok"},
      {"op": "register_adjudicator", "args": ["{\"source_contract\":\"0x2bd806c97f0e00af1a1fc3328fa763a9269723c8\",\"authority_fingerprint\":\"sha256:fp-001\",\"policy_version\":\"TECH-V1\",\"created_at\":\"2020-01-01T00:00:00+00:00\",\"expires_at\":\"2099-01-01T00:00:00+00:00\"}"], "expect": "ok"},
      {"op": "submit_decision_receipt", "args": ["{\"decision_id\":\"D6\",\"source_contract\":\"0x2bd806c97f0e00af1a1fc3328fa763a9269723c8\",\"authority_fingerprint\":\"sha256:fp-001\",\"question_hash\":\"sha256:q\",\"evidence_hash\":\"sha256:e\",\"decision_status\":\"UNDETERMINED\",\"equivalence_mode\":\"comparative\",\"policy_version\":\"TECH-V1\",\"created_at\":\"2020-01-01T00:00:00+00:00\",\"expires_at\":\"2099-01-01T00:00:00+00:00\"}"], "expect": "ok"},
      {"op": "get_receipt", "args": ["D6"], "expect": {"actionability": "NON_ACTIONABLE", "fail_reason": "REJECTED_UNDETERMINED"}}]},

    {"id": "ppa-receipt-adapter/decision-replay-007", "description": "a decision_id is consumed on first submission",
     "actions": [
      {"op": "initialize", "args": ["0x2bd806c97f0e00af1a1fc3328fa763a9269723c8", "0x0000000000000000000000000000000000000001"], "expect": "ok"},
      {"op": "register_adjudicator", "args": ["{\"source_contract\":\"0x2bd806c97f0e00af1a1fc3328fa763a9269723c8\",\"authority_fingerprint\":\"sha256:fp-001\",\"policy_version\":\"TECH-V1\",\"created_at\":\"2020-01-01T00:00:00+00:00\",\"expires_at\":\"2099-01-01T00:00:00+00:00\"}"], "expect": "ok"},
      {"op": "submit_decision_receipt", "args": ["{\"decision_id\":\"D7\",\"source_contract\":\"0x2bd806c97f0e00af1a1fc3328fa763a9269723c8\",\"authority_fingerprint\":\"sha256:fp-001\",\"question_hash\":\"sha256:q\",\"evidence_hash\":\"sha256:e\",\"decision_status\":\"REJECTED\",\"equivalence_mode\":\"comparative\",\"policy_version\":\"TECH-V1\",\"created_at\":\"2020-01-01T00:00:00+00:00\",\"expires_at\":\"2099-01-01T00:00:00+00:00\"}"], "expect": "ok"},
      {"op": "submit_decision_receipt", "args": ["{\"decision_id\":\"D7\",\"source_contract\":\"0x2bd806c97f0e00af1a1fc3328fa763a9269723c8\",\"authority_fingerprint\":\"sha256:fp-001\",\"question_hash\":\"sha256:q\",\"evidence_hash\":\"sha256:e\",\"decision_status\":\"ACCEPTED\",\"equivalence_mode\":\"comparative\",\"policy_version\":\"TECH-V1\",\"created_at\":\"2020-01-01T00:00:00+00:00\",\"expires_at\":\"2099-01-01T00:00:00+00:00\"}"], "expect": "ok"},
      {"op": "get_receipt", "args": ["D7"], "expect": {"decision_status": "REJECTED", "actionability": "NON_ACTIONABLE"}}]}
  ]
}
