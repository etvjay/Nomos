{
  "schemaVersion": "1.0.0",
  "primitiveId": "gaia",
  "name": "Gaia — Exception, Reconciliation & Rectification",
  "capabilityVersion": "0.1.0",
  "status": "SPECIFIED",
  "convergenceMode": "EXACT",
  "judgmentBearing": false,
  "implementation": {
    "environment": "genlayer",
    "path": "primitives/gaia/implementations/genlayer/gaia.py",
    "contract": "Gaia"
  },
  "publicMethods": [
    {"name": "open_case", "kind": "write", "inputs": [
      {"name": "case_id", "type": "string"},
      {"name": "category", "type": "declared-category"},
      {"name": "subject_ref", "type": "string"},
      {"name": "facts_json", "type": "json-object-as-string (<=4096 bytes)"}
    ], "output": "canonical-case-json-string"},
    {"name": "classify_case", "kind": "write", "inputs": [
      {"name": "case_id", "type": "string"},
      {"name": "classification_id", "type": "string"},
      {"name": "obligations_json", "type": "list of {type, bound} (1..8)"}
    ], "output": "canonical-classification-json-string"},
    {"name": "discharge_obligation", "kind": "write", "inputs": [
      {"name": "obligation_id", "type": "string"},
      {"name": "evidence_hash", "type": "string"}
    ], "output": "canonical-obligation-json-string"},
    {"name": "waive_obligation", "kind": "write", "inputs": [
      {"name": "obligation_id", "type": "string"},
      {"name": "waiver_note", "type": "string"}
    ], "output": "canonical-obligation-json-string"},
    {"name": "resolve_case", "kind": "write", "inputs": [
      {"name": "case_id", "type": "string"},
      {"name": "resolution_evidence_hash", "type": "string"}
    ], "output": "canonical-case-json-string"},
    {"name": "get_case", "kind": "view", "inputs": [{"name": "case_id", "type": "string"}], "output": "json-or-empty"},
    {"name": "get_obligation", "kind": "view", "inputs": [{"name": "obligation_id", "type": "string"}], "output": "json-or-empty"}
  ],
  "canonicalDecision": {
    "caseStatus": ["OPEN", "CLASSIFIED", "RESOLVED"],
    "obligationStatus": ["PRESCRIBED", "DISCHARGED", "WAIVED"],
    "categories": ["settlement-mismatch", "delivery-mismatch", "duplicate-execution", "stale-evidence", "unauthorized-action", "reconciliation-failure", "other"],
    "obligationTypes": ["refund", "retry", "provide_evidence", "correct_usage_record", "reconcile", "manual_review"],
    "equivalenceFields": ["status", "resolution_evidence_hash"]
  },
  "stateMachine": {
    "case": "OPEN -> CLASSIFIED -> RESOLVED (terminal)",
    "obligation": "PRESCRIBED -> DISCHARGED | PRESCRIBED -> WAIVED",
    "rules": [
      "one classification per case; obligation ids derived <classification_id>-O<i>",
      "resolve requires ALL obligations dispositioned (discharged with evidence or waived with note)",
      "RESOLVED is terminal: no reclassification, no re-resolution",
      "all history append-only; nothing is rewritten"
    ]
  },
  "stateOwnership": {
    "owns": ["exception cases with declared categories and facts", "bounded rectification obligations and their disposition state"],
    "doesNotOwn": ["execution authority for any remedy", "capital movement", "historical event records of other primitives", "workflow authorization"]
  },
  "limits": {
    "maxFactsBytes": 4096,
    "maxObligationsPerCase": 8,
    "duplicateCaseId": "rejected",
    "doubleClassification": "rejected",
    "doubleDisposition": "rejected",
    "dischargeWithoutEvidence": "rejected",
    "waiveWithoutNote": "rejected"
  },
  "vectors": ["primitives/gaia/vectors/v0.1.json"],
  "reproduce": [
    "python tools/nomos_lint.py",
    "python tools/nomos_converge.py check",
    "python tools/nomos_run_vectors.py primitives/gaia/implementations/genlayer/gaia.py --vectors primitives/gaia/vectors/v0.1.json"
  ],
  "composition": {
    "typicalUpstream": ["any primitive's exceptional state", "claim-verification CONFLICTED results", "policy-envelope DENY anomalies"],
    "typicalDownstream": ["workflow-authorization (remedy execution must be separately authorized)", "financial-contract", "settlement"]
  },
  "unsupported": [
    "executing any prescribed remedy — refund/retry/correction must pass ordinary Workflow Authorization",
    "rewriting historical confirmed truth (append-only by construction)",
    "automatic case creation on ordinary deterministic rejection",
    "ambiguous-exception classification inside the contract in v0.1 (interpreting party supplies the bounded classification; an LLM layer may compose upstream without changing this surface)",
    "deployment/conformance guarantee until receipts exist"
  ]
}
