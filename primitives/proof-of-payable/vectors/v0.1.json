      "actions": [
        {
          "op": "open_claim",
          "args": [
            "C1",
            "1000",
            "INV-2026-001",
            "ACME-CORP"
          ],
          "expect": "ok"
        },
        {
          "op": "attach_evidence",
          "args": [
            "C1",
            "P1",
            "sha256:aaa111",
            "{}"
          ],
          "expect": "ok"
        },
        {
          "op": "attest_claim",
          "args": [
            "C1"
          ],
          "expect": "ok"
        },
        {
          "op": "settle_claim",
          "args": [
            "C1"
          ],
          "expect": "ok"
        },
        {
          "op": "get_claim",
          "args": [
            "C1"
          ],
          "expect": {
            "claim_id": "C1",
            "amount": "1000",
            "external_ref": "INV-2026-001",
            "obligor": "ACME-CORP",
            "status": "SETTLED",
            "evidence_count": "1",
            "latest_proof_hash": "sha256:aaa111"
          }
        },
        {
          "op": "dispute_claim",
          "args": [
            "C1"
          ],
          "expect": "reject"
        },
        {
          "op": "void_claim",
          "args": [
            "C1"
          ],
          "expect": "reject"
        }
      ]
    },
    {
      "id": "pop-settle-unevidenced-rejected-013",
