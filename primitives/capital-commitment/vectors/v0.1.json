          "expect": "reject"
        },
        {
          "op": "set_backing",
          "args": [
            "POOL-1",
            "USD",
            "10000"
          ],
          "expect": "ok"
        },
        {
          "op": "reserve",
          "args": [
            "CC-1",
            "POOL-1",
            "USD",
            "ALICE",
            "1000",
            "1000"
          ],
          "expect": "ok"
