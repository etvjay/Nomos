        {
          "op": "reserve",
          "args": [
            "CC-1",
            "POOL-1",
            "USD",
            "ALICE",
            "2000",
            "1000"
          ],
          "expect": "reject"
        },
        {
          "op": "active_commitments",
          "args": [
            "POOL-1",
            "USD"
          ],
          "expect": "3000"
        }
      ]
    },
    {
      "id": "cc-reserve-unbacked-pool-rejected-006",
