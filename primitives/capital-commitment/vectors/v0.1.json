{
  "schemaVersion": "0.1.0",
  "primitive": "capital-commitment",
  "convergenceMode": "EXACT",
  "statuses": [
    "RESERVED",
    "COMMITTED",
    "RELEASED",
    "EXPIRED"
  ],
  "activeStatuses": [
    "RESERVED",
    "COMMITTED"
  ],
  "vectors": [
    {
      "id": "cc-set-backing-001",
      "description": "Setting backing capacity on a pool+asset succeeds and is reflected by the view",
      "actions": [
        {
          "op": "set_backing",
          "args": [
            "POOL-1",
            "USD",
            "10000"
          ],
          "expect": "ok"
        },
        {
          "op": "available_capacity",
          "args": [
            "POOL-1",
            "USD"
          ],
          "expect": "10000"
        },
        {
          "op": "active_commitments",
          "args": [
            "POOL-1",
            "USD"
          ],
          "expect": "0"
        }
      ]
    },
    {
      "id": "cc-set-backing-duplicate-rejected-002",
      "description": "Backing capacity is immutable once set; duplicate set is rejected",
      "actions": [
        {
          "op": "set_backing",
          "args": [
            "POOL-1",
            "USD",
            "10000"
          ],
          "expect": "ok"
        },
        {
          "op": "set_backing",
          "args": [
            "POOL-1",
            "USD",
            "20000"
          ],
          "expect": "reject"
        },
        {
          "op": "available_capacity",
          "args": [
            "POOL-1",
            "USD"
          ],
          "expect": "10000"
        }
      ]
    },
    {
      "id": "cc-reserve-within-capacity-003",
      "description": "Commitments within backing capacity succeed and accumulate active commitment",
      "actions": [
        {
          "op": "set_backing",
          "args": [
            "POOL-1",
            "USD",
            "10000"
          ],
          "expect": "ok"
        },
        {
          "op": "reserve",
          "args": [
            "CC-1",
            "POOL-1",
            "USD",
            "ALICE",
            "4000",
            "1000"
          ],
          "expect": "ok"
        },
        {
          "op": "reserve",
          "args": [
            "CC-2",
            "POOL-1",
            "USD",
            "BOB",
            "3000",
            "1000"
          ],
          "expect": "ok"
        },
        {
          "op": "active_commitments",
          "args": [
            "POOL-1",
            "USD"
          ],
          "expect": "7000"
        },
        {
          "op": "available_capacity",
          "args": [
            "POOL-1",
            "USD"
          ],
          "expect": "3000"
        },
        {
          "op": "get_commitment",
          "args": [
            "CC-1"
          ],
          "expect": {
            "commitment_id": "CC-1",
            "pool_id": "POOL-1",
            "asset": "USD",
            "beneficiary": "ALICE",
            "amount": "4000",
            "valid_until": "1000",
            "status": "RESERVED"
          }
        },
        {
          "op": "get_commitment",
          "args": [
            "CC-2"
          ],
          "expect": {
            "commitment_id": "CC-2",
            "pool_id": "POOL-1",
            "asset": "USD",
            "beneficiary": "BOB",
            "amount": "3000",
            "valid_until": "1000",
            "status": "RESERVED"
          }
        }
      ]
    },
    {
      "id": "cc-reserve-over-capacity-rejected-004",
      "description": "A commitment that would exceed backing capacity is rejected and does not mutate state",
      "actions": [
        {
          "op": "set_backing",
          "args": [
            "POOL-1",
            "USD",
            "10000"
          ],
          "expect": "ok"
        },
        {
          "op": "reserve",
          "args": [
            "CC-1",
            "POOL-1",
            "USD",
            "ALICE",
            "6000",
            "1000"
          ],
          "expect": "ok"
        },
        {
          "op": "reserve",
          "args": [
            "CC-2",
            "POOL-1",
            "USD",
            "BOB",
            "5000",
            "1000"
          ],
          "expect": "reject"
        },
        {
          "op": "active_commitments",
          "args": [
            "POOL-1",
            "USD"
          ],
          "expect": "6000"
        },
        {
          "op": "get_commitment",
          "args": [
            "CC-2"
          ],
          "expect": ""
        }
      ]
    },
    {
      "id": "cc-reserve-duplicate-rejected-005",
