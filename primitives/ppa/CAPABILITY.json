{
  "schemaVersion": "1.0.0",
  "primitiveId": "ppa",
  "name": "Programmable Payment Account",
  "capabilityVersion": "0.4.0",
  "status": "IMPLEMENTING",
  "convergenceMode": "EXACT",
  "judgmentBearing": false,
  "implementation": {
