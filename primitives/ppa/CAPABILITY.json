        {
          "name": "account_id",
          "type": "string"
        },
        {
          "name": "amount",
          "type": "uint-string"
        }
      ],
      "output": "status-string"
    },
    {
      "name": "withdraw",
      "kind": "write",
      "inputs": [
        {
          "name": "account_id",
          "type": "string"
        },
        {
          "name": "amount",
          "type": "uint-string"
        }
      ],
      "output": "status-string"
    },
    {
      "name": "send",
      "kind": "write",
      "inputs": [
        {
          "name": "account_id",
          "type": "string"
        },
        {
          "name": "payment_id",
          "type": "string"
        },
        {
          "name": "to",
          "type": "address"
        },
        {
          "name": "amount",
          "type": "uint-string"
        },
        {
          "name": "evidence_hash",
          "type": "string"
        },
        {
          "name": "memo",
          "type": "string"
        }
