      "output": "decision-object"
    },
    {
      "name": "get_payment",
      "kind": "view",
      "inputs": [
        {
          "name": "payment_id",
          "type": "string"
        }
      ],
      "output": "payment-json-or-error"
    },
    {
      "name": "register_attestation",
      "kind": "write",
      "inputs": [
        {
          "name": "attestation_id",
          "type": "string"
        },
        {
          "name": "attestation_json",
          "type": "fixed-schema-json-string"
        }
      ],
      "output": "status-string"
    },
    {
      "name": "revoke_attestation",
      "kind": "write",
      "inputs": [
