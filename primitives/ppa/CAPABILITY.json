        },
        {
          "name": "rules_json",
          "type": "json-string"
        }
      ],
      "output": "status-string"
    },
    {
      "name": "update_rules",
      "kind": "write",
      "inputs": [
        {
          "name": "account_id",
          "type": "string"
        },
        {
          "name": "rules_json",
          "type": "json-string"
        }
      ],
      "output": "status-string"
    },
    {
      "name": "get_account",
      "kind": "view",
