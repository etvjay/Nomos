{
  "schemaVersion": "0.3.0",
  "primitive": "ppa",
  "version": "v0.3-origin",
  "mode": "EXACT",
  "sender": "0x2bd806c97f0e00af1a1fc3328fa763a9269723c8",
  "note": "Receipt origin binding. The runner replays every action as the single sender `alice`, who is also the account owner, so alice registers herself as the adjudicator and origin resolves to BOUND. Cases that require a genuinely different caller (unregistered second caller) are not expressible in this corpus and are specified in primitives/ppa/implementations/genlayer/tests/test_ppa_receipt_origin.py.",
  "vectors": [
    {
      "id": "ppa/origin-bound-accepted-settles-001",
      "description": "Registered ACTIVE source, matching caller, matching fingerprint, ACCEPTED -> ACTIONABLE -> proposal -> settled",
      "actions": [
        {"op": "initialize", "args": ["0x2bd806c97f0e00af1a1fc3328fa763a9269723c8"], "expect": "ok"},
        {"op": "create_account", "args": ["ACC1", "{\"daily_limit\":\"1000\",\"per_tx_limit\":\"500\",\"currency\":\"USDC\"}"], "expect": "ok"},
        {"op": "deposit", "args": ["ACC1", "1000"], "expect": "ok"},
        {"op": "register_adjudicator", "args": ["{\"source_contract\":\"0x2bd806c97f0e00af1a1fc3328fa763a9269723c8\",\"authority_fingerprint\":\"sha256:fp-001\",\"policy_version\":\"TECH-V1\",\"created_at\":\"2020-01-01T00:00:00+00:00\",\"expires_at\":\"2099-01-01T00:00:00+00:00\"}"], "expect": "ok"},
        {"op": "submit_decision_receipt", "args": ["{\"decision_id\":\"DEC-1\",\"source_contract\":\"0x2bd806c97f0e00af1a1fc3328fa763a9269723c8\",\"authority_fingerprint\":\"sha256:fp-001\",\"question_hash\":\"sha256:q\",\"evidence_hash\":\"sha256:e\",\"decision_status\":\"ACCEPTED\",\"equivalence_mode\":\"comparative\",\"policy_version\":\"TECH-V1\",\"created_at\":\"2020-01-01T00:00:00+00:00\",\"expires_at\":\"2099-01-01T00:00:00+00:00\"}"], "expect": "ok"},
        {"op": "get_receipt", "args": ["DEC-1"], "expect": {"actionability": "ACTIONABLE", "origin_status": "BOUND", "decision_status": "ACCEPTED"}},
        {"op": "admit_proposal", "args": ["{\"proposal_id\":\"PROP-1\",\"decision_id\":\"DEC-1\",\"account_id\":\"ACC1\",\"payment_id\":\"PAY-1\",\"to\":\"0x9f6aa7364d20cf25f054ea83f3cb950317fd34b6\",\"amount\":\"100\",\"policy_version\":\"TECH-V1\"}"], "expect": "ok"},
        {"op": "get_proposal", "args": ["PROP-1"], "expect": {"status": "ADMITTED"}},
        {"op": "execute_proposal", "args": ["PROP-1"], "expect": "ok"},
        {"op": "get_payment", "args": ["PAY-1"], "expect": {"status": "SETTLED", "decision_id": "DEC-1"}},
        {"op": "get_account", "args": ["ACC1"], "expect": {"balance": "900"}}
      ]
    },
    {
      "id": "ppa/origin-source-mismatch-002",
      "description": "Registered source submits a receipt naming a different source_contract -> RECEIPT_SOURCE_MISMATCH, no movement",
      "actions": [
        {"op": "initialize", "args": ["0x2bd806c97f0e00af1a1fc3328fa763a9269723c8"], "expect": "ok"},
        {"op": "create_account", "args": ["ACC1", "{\"daily_limit\":\"1000\",\"per_tx_limit\":\"500\",\"currency\":\"USDC\"}"], "expect": "ok"},
        {"op": "deposit", "args": ["ACC1", "1000"], "expect": "ok"},
        {"op": "register_adjudicator", "args": ["{\"source_contract\":\"0x2bd806c97f0e00af1a1fc3328fa763a9269723c8\",\"authority_fingerprint\":\"sha256:fp-001\",\"policy_version\":\"TECH-V1\",\"created_at\":\"2020-01-01T00:00:00+00:00\",\"expires_at\":\"2099-01-01T00:00:00+00:00\"}"], "expect": "ok"},
        {"op": "submit_decision_receipt", "args": ["{\"decision_id\":\"DEC-2\",\"source_contract\":\"0xabc000000000000000000000000000000000001\",\"authority_fingerprint\":\"sha256:fp-001\",\"question_hash\":\"sha256:q\",\"evidence_hash\":\"sha256:e\",\"decision_status\":\"ACCEPTED\",\"equivalence_mode\":\"comparative\",\"policy_version\":\"TECH-V1\",\"created_at\":\"2020-01-01T00:00:00+00:00\",\"expires_at\":\"2099-01-01T00:00:00+00:00\"}"], "expect": "ok"},
        {"op": "get_receipt", "args": ["DEC-2"], "expect": {"actionability": "NON_ACTIONABLE", "fail_reason": "RECEIPT_SOURCE_MISMATCH"}},
        {"op": "admit_proposal", "args": ["{\"proposal_id\":\"PROP-2\",\"decision_id\":\"DEC-2\",\"account_id\":\"ACC1\",\"payment_id\":\"PAY-2\",\"to\":\"0x9f6aa7364d20cf25f054ea83f3cb950317fd34b6\",\"amount\":\"100\",\"policy_version\":\"TECH-V1\"}"], "expect": "ok"},
        {"op": "get_account", "args": ["ACC1"], "expect": {"balance": "1000"}}
      ]
    },
    {
